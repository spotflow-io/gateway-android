<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only what the gateway needs in every mode: uploading. The Bluetooth, location, foreground-service
         and notification permissions depend on how the host uses the library (an app that attaches its own
         connections already holds what its BLE stack needs; managed mode scans and connects itself, and
         may run in the service below), so the host declares them: see "Permissions and manifest" in the
         README. Declared here, they would merge into every host and could only be taken out again with
         `tools:node="remove"`, which also strips the same declarations of other libraries. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Declared, but not required: a library must not decide which devices its host app is offered to.
         An app that is useless without BLE sets required="true" in its own manifest. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application>
        <!-- Started only by apps that run a ManagedGateway in it, which declare
             FOREGROUND_SERVICE_CONNECTED_DEVICE themselves. -->
        <service
            android:name="io.spotflow.ble.managed.SpotflowGatewayService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
