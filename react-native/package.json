{
  "name": "spotflow-react-native-workspace",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "build": "pnpm --filter @spotflow/react-native-ble-gateway build && pnpm --filter @spotflow/react-native-ble-gateway-ble-manager build",
    "bundle-android": "node scripts/bundle-android.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"packages/*/src/__tests__/*.test.ts\" \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-manager": "13.0.1",
    "typescript": "~5.9.3"
  }
}
