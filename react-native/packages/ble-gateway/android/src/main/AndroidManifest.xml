<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The host app owns BLE and declares the permissions its BLE library needs; the gateway AAR declares
         only INTERNET and ACCESS_NETWORK_STATE. Its one other declaration, the service of its managed mode,
         is never started by the bridge. Only that service is removed here: its name is the gateway's own,
         so no declaration of another library is affected. -->
    <application>
        <service android:name="io.spotflow.ble.managed.SpotflowGatewayService" tools:node="remove" />
    </application>
</manifest>
